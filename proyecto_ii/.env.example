# Copy this file to '.env'

# Data
DATASET_PATH=../../dsia-dataset/data/output/energy_weather_es_hourly.csv
DATABASE_URL=sqlite:///data/energy.db

# Model and reports
MODEL_PATH=models/model.joblib
REPORTS_DIR=reports

# AI provider: mock (by default) | nvidia
AI_PROVIDER=mock
# Key from https://build.nvidia.com (starts with 'nvapi-').
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

LOG_LEVEL=INFO
